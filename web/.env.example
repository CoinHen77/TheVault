# Real Firebase web config. Only needed once we point at a live project
# (Milestone 7). The emulators work without any of these.
VITE_FIREBASE_API_KEY=
# Use the Hosting domain (the-vault-f417a.web.app), not firebaseapp.com, so sign-in works in Safari
# and installed iOS apps. Requires https://the-vault-f417a.web.app/__/auth/handler as an authorized
# redirect URI on the Google OAuth client (Google Cloud console > APIs & Services > Credentials).
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to false to run `npm run dev` against the real project instead of emulators.
VITE_USE_EMULATORS=true
