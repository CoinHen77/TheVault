{
  "name": "@vault/functions",
  "private": true,
  "version": "0.1.0",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --external:firebase-admin --external:firebase-functions --outfile=lib/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
